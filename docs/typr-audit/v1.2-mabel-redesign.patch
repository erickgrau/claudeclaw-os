+// ─── Stats ─────────────────────────────────────────────
+function fmt(n: number): string {
+  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, "") + "M";
+  if (n >= 1_000) return (n / 1_000).toFixed(1).replace(/\.0$/, "") + "k";
+  return String(n);
+}
+
+function relativeTime(iso: string | null): string {
+  if (!iso) return "No dictations yet.";
+  const then = new Date(iso).getTime();
+  const now = Date.now();
+  const sec = Math.max(0, Math.floor((now - then) / 1000));
+  if (sec < 60) return "Last dictation: just now";
+  if (sec < 3600) return `Last dictation: ${Math.floor(sec / 60)} min ago`;
+  if (sec < 86400) return `Last dictation: ${Math.floor(sec / 3600)} h ago`;
+  return `Last dictation: ${Math.floor(sec / 86400)} d ago`;
+}
+
+function renderStats(s: StatsView) {
+  todayWordsEl.textContent = fmt(s.today_words);
+  todayDictationsEl.textContent = fmt(s.today_dictations);
+  totalWordsEl.textContent = fmt(s.total_words);
+  totalDictationsEl.textContent = fmt(s.total_dictations);
+  dayStreakEl.textContent = String(s.day_streak);
+  lastUsedEl.textContent = relativeTime(s.last_used);
+}
+
