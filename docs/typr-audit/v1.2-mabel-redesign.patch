+++ b/src-tauri/src/stats.rs
@@ -0,0 +1,275 @@
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const STATS_VERSION: u32 = 1;
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct DayStats {
+    pub dictations: u64,
+    pub words: u64,
+    pub chars: u64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Stats {
+    pub version: u32,
+    pub total_dictations: u64,
+    pub total_words: u64,
+    pub total_chars: u64,
+    pub first_used: Option<String>,
+    pub last_used: Option<String>,
+    pub by_day: BTreeMap<String, DayStats>,
+}
+
+impl Default for Stats {
+    fn default() -> Self {
+        Self {
+            version: STATS_VERSION,
+            total_dictations: 0,
+            total_words: 0,
+            total_chars: 0,
+            first_used: None,
+            last_used: None,
+            by_day: BTreeMap::new(),
+        }
+    }
+}
+
+/// Public response shape for the Tauri command. Includes derived metrics so
+/// the frontend doesn't need to recompute them on every render.
+#[derive(Debug, Clone, Serialize)]
+pub struct StatsView {
+    pub total_dictations: u64,
+    pub total_words: u64,
+    pub total_chars: u64,
+    pub today_dictations: u64,
+    pub today_words: u64,
+    pub today_chars: u64,
+    pub day_streak: u64,
+    pub last_used: Option<String>,
+    pub first_used: Option<String>,
+}
+
+pub struct StatsStore {
+    inner: Mutex<Stats>,
+    path: PathBuf,
+}
+
+impl StatsStore {
+    pub fn load(app_dir: &PathBuf) -> Self {
+        let path = app_dir.join("stats.json");
+        let inner = match fs::read_to_string(&path) {
+            Ok(contents) => serde_json::from_str::<Stats>(&contents).unwrap_or_default(),
+            Err(_) => Stats::default(),
+        };
+        Self {
+            inner: Mutex::new(inner),
+            path,
+        }
+    }
+
+    /// Bump counters for one completed dictation. Content of the transcript
+    /// is NEVER stored. Only its length.
+    pub fn record_dictation(&self, app_dir: &PathBuf, char_count: u64, word_count: u64) {
+        let now_iso = current_iso8601();
+        let today = current_date_yyyy_mm_dd();
+
+        let mut stats = self.inner.lock().unwrap();
+        stats.total_dictations += 1;
+        stats.total_words += word_count;
+        stats.total_chars += char_count;
+        if stats.first_used.is_none() {
+            stats.first_used = Some(now_iso.clone());
+        }
+        stats.last_used = Some(now_iso);
+
+        let entry = stats.by_day.entry(today).or_default();
+        entry.dictations += 1;
+        entry.words += word_count;
+        entry.chars += char_count;
+
+        // Persist. Failure is logged but not surfaced to the user.
+        if let Err(e) = persist(&self.path, app_dir, &stats) {
+            eprintln!("[Mabel] Failed to persist stats: {}", e);
+        }
+    }
+
+    pub fn view(&self) -> StatsView {
+        let stats = self.inner.lock().unwrap();
+        let today = current_date_yyyy_mm_dd();
+        let today_stats = stats.by_day.get(&today).cloned().unwrap_or_default();
+        StatsView {
+            total_dictations: stats.total_dictations,
+            total_words: stats.total_words,
+            total_chars: stats.total_chars,
+            today_dictations: today_stats.dictations,
+            today_words: today_stats.words,
+            today_chars: today_stats.chars,
+            day_streak: compute_day_streak(&stats.by_day),
+            last_used: stats.last_used.clone(),
+            first_used: stats.first_used.clone(),
+        }
+    }
+
+    pub fn reset(&self, app_dir: &PathBuf) -> Result<(), String> {
+        let mut stats = self.inner.lock().unwrap();
+        *stats = Stats::default();
+        persist(&self.path, app_dir, &stats)
+    }
+}
+
+fn persist(path: &PathBuf, app_dir: &PathBuf, stats: &Stats) -> Result<(), String> {
+    fs::create_dir_all(app_dir).map_err(|e| e.to_string())?;
+    let json = serde_json::to_string_pretty(stats).map_err(|e| e.to_string())?;
+    fs::write(path, json).map_err(|e| e.to_string())
+}
+
+/// Number of consecutive days ending today (or yesterday if today has no
+/// activity yet) that have at least one dictation. Today counts even if the
+/// user hasn't dictated yet today, as long as yesterday was active.
+fn compute_day_streak(by_day: &BTreeMap<String, DayStats>) -> u64 {
+    let today = current_date_yyyy_mm_dd();
+    let mut cursor = if by_day.contains_key(&today) {
+        today
+    } else {
+        previous_date(&today)
+    };
+    let mut streak = 0u64;
+    loop {
+        match by_day.get(&cursor) {
+            Some(day) if day.dictations > 0 => {
+                streak += 1;
+                cursor = previous_date(&cursor);
+            }
+            _ => break,
+        }
+    }
+    streak
+}
+
+fn current_iso8601() -> String {
+    let secs = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0);
+    format_iso8601(secs)
+}
+
+fn current_date_yyyy_mm_dd() -> String {
+    let secs = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0);
+    let (y, m, d) = unix_to_ymd(secs as i64);
+    format!("{:04}-{:02}-{:02}", y, m, d)
+}
+
+fn previous_date(yyyy_mm_dd: &str) -> String {
+    let parts: Vec<&str> = yyyy_mm_dd.split('-').collect();
+    if parts.len() != 3 {
+        return yyyy_mm_dd.to_string();
+    }
+    let y: i64 = parts[0].parse().unwrap_or(2026);
+    let m: i64 = parts[1].parse().unwrap_or(1);
+    let d: i64 = parts[2].parse().unwrap_or(1);
+    let secs = ymd_to_unix(y, m, d) - 86_400;
+    let (py, pm, pd) = unix_to_ymd(secs);
+    format!("{:04}-{:02}-{:02}", py, pm, pd)
+}
+
+fn format_iso8601(secs: u64) -> String {
+    let (y, mo, d) = unix_to_ymd(secs as i64);
+    let s_in_day = (secs % 86_400) as i64;
+    let h = s_in_day / 3600;
+    let mi = (s_in_day % 3600) / 60;
+    let se = s_in_day % 60;
+    format!(
+        "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z",
+        y, mo, d, h, mi, se
+    )
+}
+
+/// Convert Unix epoch seconds (UTC) to (year, month, day). Tiny dependency-free
+/// implementation good for years 1970-9999.
+fn unix_to_ymd(secs: i64) -> (i64, i64, i64) {
+    let days_since_epoch = secs.div_euclid(86_400);
+    // Days since 1970-01-01.
+    let z = days_since_epoch + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = if m <= 2 { y + 1 } else { y };
+    (y, m, d)
+}
+
+fn ymd_to_unix(y: i64, m: i64, d: i64) -> i64 {
+    let y = if m <= 2 { y - 1 } else { y };
+    let era = y.div_euclid(400);
+    let yoe = y - era * 400;
+    let mp = if m > 2 { m - 3 } else { m + 9 };
+    let doy = (153 * mp + 2) / 5 + d - 1;
+    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    let days_since_epoch = era * 146_097 + doe - 719_468;
+    days_since_epoch * 86_400
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ymd_round_trip() {
+        let cases = [(2026, 4, 25), (1970, 1, 1), (2000, 2, 29), (2099, 12, 31)];
+        for (y, m, d) in cases {
+            let secs = ymd_to_unix(y, m, d);
+            let (yy, mm, dd) = unix_to_ymd(secs);
+            assert_eq!((y, m, d), (yy, mm, dd));
+        }
+    }
+
+    #[test]
+    fn previous_date_handles_month_rollover() {
+        assert_eq!(previous_date("2026-05-01"), "2026-04-30");
+        assert_eq!(previous_date("2026-01-01"), "2025-12-31");
+        assert_eq!(previous_date("2024-03-01"), "2024-02-29"); // leap year
+    }
+
+    #[test]
+    fn day_streak_zero_when_no_activity() {
+        let by_day = BTreeMap::new();
+        assert_eq!(compute_day_streak(&by_day), 0);
+    }
+
+    #[test]
+    fn day_streak_continues_through_today_or_yesterday() {
+        let mut by_day = BTreeMap::new();
+        let yesterday = previous_date(&current_date_yyyy_mm_dd());
+        let day_before = previous_date(&yesterday);
+        by_day.insert(
+            yesterday,
+            DayStats {
+                dictations: 1,
+                words: 5,
+                chars: 20,
+            },
+        );
+        by_day.insert(
+            day_before,
+            DayStats {
+                dictations: 1,
+                words: 5,
+                chars: 20,
+            },
+        );
+        assert_eq!(compute_day_streak(&by_day), 2);
+    }
+}
